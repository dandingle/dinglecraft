# DINGLECRAFT local secrets. Copy this file to .env (gitignored) and fill in the keys you need.
# This example holds NAMES ONLY: never put a real value here, never commit .env.

# --- Keys (read from .env; an exported shell variable of the same name also works) ---------------
# The AI players' brain: bring your own Anthropic key (npm run brain / Start AI Brain.command).
# The .env value wins over the shell's.
ANTHROPIC_API_KEY=
# The art pipeline only (tools/art/fal.mjs; PAID). Here the shell's FAL_KEY wins over .env.
FAL_KEY=

# --- Optional settings: ENVIRONMENT variables (export them in your shell; not read from .env) ------
# DINGLE_ENV_PATH=       brain + fal: read the keys from another dotenv file instead of this one
# DINGLE_GAME_DIR=       brain: folder it serves the newest dinglecraft_v*.html from (default dist/)
# DINGLE_DATA_DIR=       brain: tokens + spend/turn logs (default brain/data/)
# DINGLE_BRAIN_PORT=8644 brain: its port on 127.0.0.1
# DINGLE_NO_OPEN=1       brain launcher: do not open the browser
# DC_ART_SRC=            art repack: Hyperreal source folder (holds final/ and final_ent/)
# DC_MG_ART_SRC=         art repack: Malgorath workspace (holds final/ with the mg_* maps)
# DC_PG_ART_SRC=         purgatory art tools: workspace for staged/ and sheets/ (default out/art/purgatory/)
# FAL_LEDGER_DIR=        fal: folder holding costs.md + BUDGET (default .art-ledger/)
# FAL_BUDGET_USD=        fal: spend cap when FAL_LEDGER_DIR has no BUDGET file (no cap = refuses to run)
# CHROME=                QA rigs: Chrome binary (default: the standard macOS app path)
